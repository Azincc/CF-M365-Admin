{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "m365",
  "main": "worker.js",
  "compatibility_date": "2026-03-18",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV"
    }
  ]
}
